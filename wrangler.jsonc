{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stacktoit-examples",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./_cf",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "stacktoit.com/examples", "zone_name": "stacktoit.com" },
    { "pattern": "stacktoit.com/examples/*", "zone_name": "stacktoit.com" }
  ]
}
